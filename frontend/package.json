{
  "name": "litiaina-mx-frontend",
  "private": true,
  "version": "1.0.0-rc.1",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-release.mjs && node scripts/verify-office.mjs && svelte-check --tsconfig ./tsconfig.app.json && vite build",
    "check:release": "node scripts/check-release.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.app.json",
    "test": "vitest run",
    "test:calls:browser": "node tests/call-media.browser.mjs",
    "test:network:browser": "node tests/network-resilience.browser.mjs",
    "test:eight-users:browser": "node tests/eight-user.browser.mjs",
    "test:drive:browser": "node tests/drive.browser.mjs",
    "test:drive:file-manager": "node tests/drive-file-manager.browser.mjs",
    "test:drive:polish": "node tests/drive-polish.browser.mjs",
    "test:drive:dropdowns": "node tests/drive-dropdowns.browser.mjs",
    "test:drive:recovery": "node tests/drive-recovery.browser.mjs",
    "test:media:recovery": "node tests/media-recovery.browser.mjs",
    "test:drive:sharing": "node tests/drive-sharing.browser.mjs",
    "test:relationships:browser": "node tests/relationships.browser.mjs",
    "test:relationships:autofill": "node tests/relationship-autofill.browser.mjs",
    "test:fields:archive": "node tests/field-archive.browser.mjs",
    "test:fields:errors": "node tests/field-errors.browser.mjs",
    "test:fields:datatype": "node tests/field-type-change.browser.mjs",
    "test:forms:rules": "node tests/form-rules.browser.mjs",
    "test:ui:cascade": "node tests/ui-cascade.browser.mjs",
    "test:backups:browser": "node tests/backups.browser.mjs",
    "test:updates": "node --no-warnings tests/updates.integration.mjs",
    "test:updates:cli": "node tests/update-cli.integration.mjs",
    "test:records:scroll": "node tests/record-scroll.browser.mjs",
    "test:records:window": "node tests/record-window.browser.mjs",
    "test:records:summaries": "node tests/record-summaries.browser.mjs",
    "test:records:import": "node tests/import-records.browser.mjs",
    "test:records:import-menu": "node tests/module-import-menu.browser.mjs",
    "test:records:import-layout": "node tests/import-layout.browser.mjs",
    "test:office:browser": "node tests/office.browser.mjs",
    "test:office:loading": "node tests/office-loading.browser.mjs",
    "test:office:recovery": "node tests/office-recovery.browser.mjs",
    "test:office:durable": "node tests/office-durable.browser.mjs",
    "test:office:prompt": "node tests/office-prompt-layout.browser.mjs",
    "test:office:previews": "node tests/office-previews.integration.mjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^24.19.1",
    "playwright": "1.63.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@lucide/svelte": "^1.48.0"
  }
}
