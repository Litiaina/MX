[Unit]
Description=Litiaina MX
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/mx
Environment=MX_UPDATE_CONFIG=/srv/mx/mx-updates.json
ExecStart=/srv/mx-updates/current/litiaina-mx
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=control-group
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
